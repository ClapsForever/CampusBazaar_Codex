[Unit]
Description=licx CampusBazaar Pi Agent on Aliyun
Wants=campusbazaar-licx-api.service
After=campusbazaar-licx-api.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/licx/campusbazaar/current/backend/agent
EnvironmentFile=/home/licx/campusbazaar/shared/env/agent.env
ExecStart=/home/licx/campusbazaar/runtime/nodejs/bin/node --max-old-space-size=384 dist/server.js
TimeoutStopSec=90
MemoryMax=640M
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
Slice=campusbazaar-licx.slice

[Install]
WantedBy=default.target
