[Unit]
Description=licx CampusBazaar business API on Aliyun
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/licx/campusbazaar/current/backend/api
Environment=NODE_ENV=production
EnvironmentFile=/home/licx/campusbazaar/shared/env/api.env
ExecStart=/home/licx/campusbazaar/runtime/nodejs/bin/node --max-old-space-size=128 dist/src/main.js
TimeoutStopSec=90
MemoryMax=256M
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
Slice=campusbazaar-licx.slice

[Install]
WantedBy=default.target
