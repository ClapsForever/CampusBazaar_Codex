[Unit]
Description=licx CampusBazaar HTTPS entry point
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
User=licx
Group=licx
ExecStart=/opt/campusbazaar-licx-https/caddy run --config /etc/campusbazaar-licx-https/Caddyfile --adapter caddyfile
ExecReload=/opt/campusbazaar-licx-https/caddy reload --config /etc/campusbazaar-licx-https/Caddyfile --adapter caddyfile --address unix//home/licx/campusbazaar/https/admin.sock
Environment=HOME=/home/licx
Environment=XDG_DATA_HOME=/home/licx/campusbazaar/https/data
Environment=XDG_CONFIG_HOME=/home/licx/campusbazaar/https/config
Environment=GOMEMLIMIT=160MiB
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/licx/campusbazaar/https
PrivateTmp=true
UMask=0077
MemoryMax=256M
TasksMax=128
LimitNOFILE=8192
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
