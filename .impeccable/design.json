      "css": ".ds-product{display:flex;flex-direction:column;align-items:stretch;width:154px;padding:0;border:0;background:#FFFFFF;border-radius:14px;overflow:hidden;text-align:left;font-family:system-ui,sans-serif;cursor:pointer;}.ds-product-image{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;width:100%;aspect-ratio:1;background:#EAF0F8;color:#5E6C83;border-radius:14px;font-size:12px;}.ds-product-image svg{width:28px;height:28px;}.ds-product-copy{display:flex;flex-direction:column;gap:7px;padding:12px 12px 14px;min-width:0;}.ds-product-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:14px;font-weight:500;color:#17243C;}.ds-product-price{font-size:21px;font-weight:700;color:#2345CE;}.ds-product-condition,.ds-product-campus{font-size:12px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}.ds-product-condition{color:#52617A;}.ds-product-campus{color:#5E6C83;}.ds-product:hover{filter:brightness(.99);}.ds-product:focus-visible{outline:2px solid #2345CE;outline-offset:3px;}.ds-product:active{filter:brightness(.97);}"
    },
    {
      "name": "紧凑商品卡片",
