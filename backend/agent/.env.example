# 服务
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_AUTH_TOKEN=replace-with-api-agent-service-token

# 本机完整后端：真实模型 + 业务 API 商品
MOCK_BACKEND=false
MODEL_MODE=real
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=

# 业务后端 HTTP 适配器（MOCK_BACKEND=false 时使用）
BUSINESS_BACKEND_URL=http://127.0.0.1:8080
BUSINESS_BACKEND_TOKEN=replace-with-api-internal-agent-token
BUSINESS_SEARCH_PATH=/internal/listings/search
BUSINESS_DETAIL_PATH=/internal/listings/{listingId}
BUSINESS_PREFERENCES_PATH=/internal/users/preferences

# 限制
MAX_MESSAGE_CHARS=2000
MAX_RESULTS=10
MAX_TOOL_CALLS=6
TOOL_TIMEOUT_MS=10000
TURN_TIMEOUT_MS=60000
SESSION_TTL_MS=86400000
