APP_MODE=local
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./.local-data/campusbazaar.sqlite
UPLOAD_DIR=./.local-data/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8080
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters
AGENT_BASE_URL=http://127.0.0.1:3000
AGENT_SERVICE_TOKEN=replace-with-agent-service-token-a
INTERNAL_AGENT_TOKEN=replace-with-business-backend-token-b
AGENT_SCHOOL_ID=school_demo

# disabled keeps existing logins available but does NOT permit unverified registrations.
EMAIL_PROVIDER=disabled
EMAIL_SEND_DAILY_LIMIT=200
# Set EMAIL_PROVIDER=aliyun only after DirectMail and HTTPS are configured.
ALIYUN_DM_REGION_ID=cn-hangzhou
ALIYUN_DM_SENDER=noreply@notify.example.com
ALIYUN_DM_SENDER_NAME=同窗集
ALIYUN_DM_CREDENTIAL_TYPE=ecs_ram_role
ALIYUN_DM_ROLE_NAME=
# Only for credential type access_key; never put real values in source control.
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
