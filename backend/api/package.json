{
  "name": "campusbazaar-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/main.js",
    "accounts:import": "node --env-file-if-exists=.env dist/src/account-cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.7",
    "@alicloud/dm20151123": "1.11.0",
    "@alicloud/openapi-core": "1.0.8",
    "@darabonba/typescript": "1.0.5"
  }
}
